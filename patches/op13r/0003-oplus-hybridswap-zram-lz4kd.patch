diff --git a/vendor/oplus/kernel/mm/hybridswap_zram/Kconfig b/vendor/oplus/kernel/mm/hybridswap_zram/Kconfig
index 29a0f5834..7360173d8 100755
--- a/vendor/oplus/kernel/mm/hybridswap_zram/Kconfig
+++ b/vendor/oplus/kernel/mm/hybridswap_zram/Kconfig
@@ -2,7 +2,7 @@
 config HYBRIDSWAP_ZRAM
 	tristate "Compressed RAM block device support"
 	depends on BLOCK && SYSFS && HYBRID_ZSMALLOC && CRYPTO && !ZRAM
-	depends on CRYPTO_LZO || CRYPTO_ZSTD || CRYPTO_LZ4 || CRYPTO_LZ4HC || CRYPTO_842
+	depends on CRYPTO_LZO || CRYPTO_ZSTD || CRYPTO_LZ4 || CRYPTO_LZ4HC || CRYPTO_LZ4KD || CRYPTO_842
 	help
 	  Creates virtual block devices called /dev/zramX (X = 0, 1, ...).
 	  Pages written to these disks are compressed and stored in memory
diff --git a/vendor/oplus/kernel/mm/hybridswap_zram/zcomp.c b/vendor/oplus/kernel/mm/hybridswap_zram/zcomp.c
index 54368a72a..0144bc7bc 100755
--- a/vendor/oplus/kernel/mm/hybridswap_zram/zcomp.c
+++ b/vendor/oplus/kernel/mm/hybridswap_zram/zcomp.c
@@ -28,6 +28,9 @@ static const char * const backends[] = {
 #if IS_ENABLED(CONFIG_CRYPTO_LZ4HC)
 	"lz4hc",
 #endif
+#if IS_ENABLED(CONFIG_CRYPTO_LZ4KD)
+	"lz4kd",
+#endif
 #if IS_ENABLED(CONFIG_CRYPTO_842)
 	"842",
 #endif
diff --git a/vendor/oplus/kernel/mm/hybridswap_zram/zram_drv.c b/vendor/oplus/kernel/mm/hybridswap_zram/zram_drv.c
index 2139f2c7a..da536290d 100755
--- a/vendor/oplus/kernel/mm/hybridswap_zram/zram_drv.c
+++ b/vendor/oplus/kernel/mm/hybridswap_zram/zram_drv.c
@@ -1075,6 +1075,14 @@ static ssize_t comp_algorithm_store(struct device *dev,
 	if (sz > 0 && compressor[sz - 1] == '\n')
 		compressor[sz - 1] = 0x00;
 
+#if IS_ENABLED(CONFIG_ZRAM_DEF_COMP_LZ4KD)
+	/*
+	 * OxygenOS writes lz4 during early boot. Keep the kernel-selected
+	 * LZ4KD backend active for this OP13R configuration.
+	 */
+	strscpy(compressor, CONFIG_ZRAM_DEF_COMP, sizeof(compressor));
+#endif
+
 	if (!zcomp_available_algorithm(compressor))
 		return -EINVAL;
 
